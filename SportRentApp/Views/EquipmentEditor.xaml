<?xml version='1.0' encoding='utf-8'?>
<local:OverlayWindow xmlns:local="clr-namespace:SportRentApp" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="SportRentApp.EquipmentEditor" Title="Sport Drive — Товар" Width="740" Height="740" MinWidth="600" MinHeight="620" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="#312C2C" Foreground="#E3DCD8" FontFamily="pack://application:,,,/SportRentApp;component/Resources/Nunito/#Nunito" Closing="Window_Closing">
    <local:OverlayWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SportRentApp;component/Styles/CatalogStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </local:OverlayWindow.Resources>
    <Border Margin="22" Background="#5E4949" CornerRadius="25" Padding="28">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="Heading" Text="Новий товар" FontSize="28" FontWeight="Light" Margin="0,0,0,10"/>
            <ScrollViewer Style="{x:Null}" ClipToBounds="True" Grid.Row="1" VerticalScrollBarVisibility="Hidden" Padding="0,0,10,0">
                <StackPanel x:Name="Fields">
                    <TextBlock Text="Назва товару *" Style="{StaticResource CatalogLabel}"/>
                    <TextBox x:Name="NameInput" Style="{StaticResource CatalogInput}" MaxLength="160" AutomationProperties.Name="Назва товару"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="Категорія *" Style="{StaticResource CatalogLabel}"/>
                            <TextBox x:Name="CategoryInput" Style="{StaticResource CatalogInput}" MaxLength="80" AutomationProperties.Name="Категорія"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Ціна за добу, грн *" Style="{StaticResource CatalogLabel}"/>
                            <TextBox x:Name="PriceInput" Style="{StaticResource CatalogInput}" MaxLength="12" AutomationProperties.Name="Ціна за добу"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="Опис" Style="{StaticResource CatalogLabel}"/>
                    <TextBox x:Name="DescriptionInput" Style="{StaticResource CatalogInput}" AcceptsReturn="True" TextWrapping="Wrap" Height="105" VerticalScrollBarVisibility="Hidden" MaxLength="4000" AutomationProperties.Name="Опис"/>
                    <TextBlock Text="Фото товару" Style="{StaticResource CatalogLabel}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Border Height="110" Background="#B8AFA8" CornerRadius="13">
                            <Grid>
                                <TextBlock Text="Без фото" Foreground="#574D47" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Image x:Name="PhotoPreview" Stretch="Uniform"/>
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                            <Button Content="Вибрати фото" HorizontalAlignment="Left" Style="{StaticResource CatalogButton}" Click="Photo_Click"/>
                            <TextBlock Text="JPEG або PNG, до 10 МБ" FontSize="12" Foreground="#CFBFB8" Margin="0,9,0,0"/>
                            <TextBlock x:Name="PhotoName" Foreground="#CFBFB8" FontSize="12" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
            <TextBlock x:Name="ErrorLabel" Grid.Row="2" Foreground="#FFD0BF" TextWrapping="Wrap" Margin="0,14,0,0" AutomationProperties.LiveSetting="Assertive"/>
            <DockPanel Grid.Row="3" Margin="0,20,0,0">
                <Button x:Name="SaveButton" DockPanel.Dock="Right" Content="Зберегти товар" Style="{StaticResource CatalogPrimary}" Click="Save_Click"/>
                <Button x:Name="CancelButton" Content="Скасувати" HorizontalAlignment="Left" Style="{StaticResource CatalogButton}" Click="Cancel_Click"/>
            </DockPanel>
        </Grid>
    </Border>
</local:OverlayWindow>
