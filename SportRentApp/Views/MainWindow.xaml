<?xml version='1.0' encoding='utf-8'?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:SportRentApp" x:Class="SportRentApp.MainWindow" Title="Sport Drive — Каталог" Width="1280" Height="960" MinWidth="320" MinHeight="240" WindowStartupLocation="CenterScreen" Background="#312C2C" Foreground="#E3DCD8" FontFamily="pack://application:,,,/SportRentApp;component/Resources/Nunito/#Nunito" UseLayoutRounding="True" Loaded="Window_Loaded">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SportRentApp;component/Styles/CatalogStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid x:Name="Viewport" SizeChanged="Viewport_SizeChanged" ClipToBounds="True">
        <Viewbox Stretch="Uniform">
            <Grid x:Name="LayoutRoot" Width="1100" Height="780">
                <local:CatalogSurface x:Name="Surface" Margin="10" Background="#312C2C">
                    <Grid x:Name="ContentArea" Margin="46,30,86,30">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="140"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid>
                            <local:BrandLogo Width="240" Height="116" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Orientation="Horizontal">
                                <TextBlock x:Name="VisitorLabel" Visibility="Collapsed" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="#EAE1DC" MaxWidth="160" TextTrimming="CharacterEllipsis"/>
                                <Button x:Name="ProfileButton" Style="{StaticResource CatalogButton}" Background="Transparent" Padding="8" Click="Profile_Click">
                                    <TextBlock x:Name="UserLabel" Foreground="#CFBFB8" VerticalAlignment="Center" Margin="0" MaxWidth="180" TextTrimming="CharacterEllipsis"/>
                                </Button>
                                <Button x:Name="AvatarButton" Style="{StaticResource CatalogButton}" Background="Transparent" Padding="0" Margin="0,0,12,0" Click="AvatarMenu_Click" AutomationProperties.Name="Меню профілю">
                                    <ContentControl x:Name="ProfileAvatar"/>
                                </Button>
                                <Button x:Name="MyOrdersButton" Content="Мої замовлення" Click="MyOrders_Click" Visibility="Collapsed" Style="{StaticResource CatalogButton}" Margin="0,0,8,0"/>
                                <Button x:Name="VisitButton" Content="Увійти за номером" Visibility="Collapsed" Style="{StaticResource CatalogPrimary}" Click="Visit_Click" Padding="14,8"/>
                                <Button x:Name="LogoutButton" Content="Вийти" Style="{StaticResource CatalogButton}" Click="BtnLogout_Click" Padding="14,8"/>
                            </StackPanel>
                            <ContentControl x:Name="WorkplaceNavigation" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,58,0,0" Visibility="Collapsed"/>
                            <Button x:Name="AddButton" Content="Додати товар" Style="{StaticResource CatalogToolbarPrimary}" Click="Add_Click" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,58,0,0"/>
                        </Grid>
                        <Border Grid.Row="1" Width="7" HorizontalAlignment="Left" Background="#4D3B3B" CornerRadius="4" Margin="-14,54,0,0" IsHitTestVisible="False"/>
                        <Grid Grid.Row="1" ClipToBounds="False">
                            <ContentControl x:Name="WorkplacePanel" Visibility="Collapsed"/>
                            <Grid x:Name="CatalogPanel">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="1" Height="38" Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="180"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Margin="-14,0,12,0">
                                        <TextBox x:Name="SearchBox" Style="{StaticResource CatalogInput}" TextChanged="Filter_Changed" AutomationProperties.Name="Пошук спорядження"/>
                                        <TextBlock x:Name="SearchHint" Text="Знайти спорядження…" Foreground="#7C726D" VerticalAlignment="Center" Margin="16,0" IsHitTestVisible="False"/>
                                    </Grid>
                                    <Border Grid.Column="1" Style="{StaticResource ResultBadge}" Margin="0,0,12,0">
                                        <TextBlock x:Name="CatalogCount" Text="0 знайдено" VerticalAlignment="Center"/>
                                    </Border>
                                    <ComboBox x:Name="CategoryBox" Grid.Column="2" Style="{StaticResource CatalogSelect}" SelectionChanged="Category_Changed" AutomationProperties.Name="Категорія"/>
                                </Grid>
                                <ScrollViewer x:Name="CatalogScroll" Grid.Row="2" Margin="0,0,0,-5" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0" SizeChanged="CatalogScroll_SizeChanged">
                                    <ItemsControl x:Name="ProductList" Margin="5,0,5,90">
                                        <ItemsControl.ItemContainerStyle>
                                            <Style TargetType="ContentPresenter">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Panel.ZIndex" Value="10"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button FocusVisualStyle="{x:Null}" Height="202" Padding="0" Click="Product_Click" Tag="{Binding}" Margin="0,8,16,18" Width="{Binding CardWidth, RelativeSource={RelativeSource AncestorType=Window}}" Background="Transparent" Cursor="Hand" ToolTipService.IsEnabled="False">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Canvas Height="202" ClipToBounds="False">
                                                                            <Border x:Name="Card" Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Height="202" VerticalAlignment="Top" Background="#503C3B" CornerRadius="12" Padding="12" RenderTransformOrigin="0.5,0" ClipToBounds="True">
                                                                                <Border.RenderTransform>
                                                                                    <TransformGroup>
                                                                                        <ScaleTransform/>
                                                                                        <TranslateTransform/>
                                                                                    </TransformGroup>
                                                                                </Border.RenderTransform>
                                                                                <Grid>
                                                                                    <Border x:Name="PhotoFrame" Background="#604B4A" CornerRadius="8" Height="100" VerticalAlignment="Top" ClipToBounds="True">
                                                                                        <Image Source="{Binding Photo}" Stretch="UniformToFill"/>
                                                                                    </Border>
                                                                                    <StackPanel x:Name="Info" Margin="3,112,3,0" VerticalAlignment="Top">
                                                                                        <StackPanel.RenderTransform>
                                                                                            <TranslateTransform/>
                                                                                        </StackPanel.RenderTransform>
                                                                                        <TextBlock Text="{Binding Name}" Foreground="#EAE1DC" FontSize="20" TextTrimming="CharacterEllipsis"/>
                                                                                        <TextBlock Text="{Binding PriceLabel}" Foreground="#D0BFB6" FontSize="16" Margin="0,5,0,0"/>
                                                                                        <StackPanel x:Name="Extra" Opacity="0" Margin="0,10,0,0">
                                                                                            <TextBlock Text="{Binding Description}" Foreground="#D0BFB6" FontSize="16" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="44" Margin="0,5,0,0"/>
                                                                                        </StackPanel>
                                                                                    </StackPanel>
                                                                                </Grid>
                                                                            </Border>
                                                                        </Canvas>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Trigger.EnterActions>
                                                                                    <BeginStoryboard>
                                                                                        <Storyboard>
                                                                                            <DoubleAnimation Storyboard.TargetName="Card" Storyboard.TargetProperty="Height" To="268" Duration="0:0:0.2"/>
                                                                                            <DoubleAnimation Storyboard.TargetName="Card" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)" To="1.025" Duration="0:0:0.2"/>
                                                                                            <DoubleAnimation Storyboard.TargetName="Card" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)" To="-5" Duration="0:0:0.2"/>
                                                                                            <DoubleAnimation Storyboard.TargetName="PhotoFrame" Storyboard.TargetProperty="Height" To="114" Duration="0:0:0.2"/>
                                                                                            <DoubleAnimation Storyboard.TargetName="Info" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="14" Duration="0:0:0.2"/>
                                                                                            <DoubleAnimation Storyboard.TargetName="Extra" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/>
                                                                                        </Storyboard>
                                                                                    </BeginStoryboard>
                                                                                </Trigger.EnterActions>
                                                                                <Trigger.ExitActions>
                                                                                    <BeginStoryboard>
                                                                                        <Storyboard>
                                                                                            <DoubleAnimation Storyboard.TargetName="Card" Storyboard.TargetProperty="Height" To="202" Duration="0:0:0.16"/>
                                                                                            <DoubleAnimation Storyboard.TargetName="Card" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.16"/>
                                                                                            <DoubleAnimation Storyboard.TargetName="Card" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)" To="0" Duration="0:0:0.16"/>
                                                                                            <DoubleAnimation Storyboard.TargetName="PhotoFrame" Storyboard.TargetProperty="Height" To="100" Duration="0:0:0.16"/>
                                                                                            <DoubleAnimation Storyboard.TargetName="Info" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="0" Duration="0:0:0.16"/>
                                                                                            <DoubleAnimation Storyboard.TargetName="Extra" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16"/>
                                                                                        </Storyboard>
                                                                                    </BeginStoryboard>
                                                                                </Trigger.ExitActions>
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                <TextBlock x:Name="EmptyLabel" Grid.Row="2" Text="Товарів не знайдено." Foreground="#CFBFB8" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                            </Grid>
                            <ScrollViewer x:Name="DetailPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Hidden">
                                <StackPanel>
                                    <Button Content="←  До каталогу" HorizontalAlignment="Left" Style="{StaticResource CatalogButton}" Click="Back_Click" Margin="0,0,0,18"/>
                                    <DockPanel Margin="0,0,0,22">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <Button x:Name="RentButton" Content="Орендувати" Visibility="Collapsed" Style="{StaticResource CatalogPrimary}" Click="Rent_Click" Margin="0,0,8,0"/>
                                            <Button x:Name="EditButton" Content="Редагувати" Style="{StaticResource CatalogPrimary}" Click="Edit_Click" Margin="0,0,8,0"/>
                                            <Button x:Name="RestoreButton" Content="Відновити доступність" Visibility="Collapsed" Style="{StaticResource CatalogButton}" Click="Restore_Click" Margin="0,0,8,0"/>
                                            <Button x:Name="DeleteButton" Content="Видалити" Style="{StaticResource CatalogButton}" Click="Delete_Click"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Name}" FontSize="28" FontWeight="Light" TextWrapping="Wrap" Margin="0,0,15,0"/>
                                    </DockPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <Border Background="#B8AFA8" CornerRadius="20" Height="270" Margin="0,0,26,0">
                                            <Grid>
                                                <TextBlock Text="" Foreground="#574D47" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <Image Source="{Binding Photo}" Stretch="Uniform"/>
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Category}" Foreground="#CFBFB8"/>
                                            <TextBlock Text="{Binding PriceLabel}" FontSize="25" Margin="0,20,0,12"/>
                                            <TextBlock Text="{Binding StatusLabel}" Foreground="#D6E0CE"/>
                                            <TextBlock Text="{Binding AvailabilityLabel}" Foreground="#D0BFB6" FontSize="16" TextWrapping="Wrap" Margin="0,8,0,12"/>
                                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Foreground="#D0C2BB" Margin="0,20,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                        <Grid Grid.Row="2" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="RetryButton" Grid.Column="1" Content="Повторити" Visibility="Collapsed" Style="{StaticResource CatalogButton}" Click="Retry_Click"/>
                            <StackPanel x:Name="Grooves" HorizontalAlignment="Left" VerticalAlignment="Bottom" Width="390" MaxWidth="{Binding ActualWidth, ElementName=ContentArea}" IsHitTestVisible="False">
                                <Border Height="7" Background="#4D3B3B" CornerRadius="4"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                    <UniformGrid x:Name="TabStrip" Rows="6" Columns="1" HorizontalAlignment="Right" Margin="0,18,24,18" Width="42">
                        <Button x:Name="CatalogTab" Click="Catalog_Click" Style="{StaticResource CatalogButton}" Background="Transparent" Padding="0" AutomationProperties.Name="каталог">
                            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="0,10">
                                <TextBlock Text="каталог" FontSize="18">
                                    <TextBlock.LayoutTransform>
                                        <RotateTransform Angle="-90"/>
                                    </TextBlock.LayoutTransform>
                                </TextBlock>
                            </Viewbox>
                        </Button>
                        <Button x:Name="RentalsTab" Click="Rentals_Click" Style="{StaticResource CatalogButton}" Background="Transparent" Padding="0" AutomationProperties.Name="клієнти">
                            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="0,10">
                                <TextBlock Text="клієнти" FontSize="18">
                                    <TextBlock.LayoutTransform>
                                        <RotateTransform Angle="-90"/>
                                    </TextBlock.LayoutTransform>
                                </TextBlock>
                            </Viewbox>
                        </Button>
                        <Button x:Name="TeamTab" Click="Team_Click" Style="{StaticResource CatalogButton}" Background="Transparent" Padding="0" AutomationProperties.Name="працівники">
                            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="0,10">
                                <TextBlock Text="працівники" FontSize="18">
                                    <TextBlock.LayoutTransform>
                                        <RotateTransform Angle="-90"/>
                                    </TextBlock.LayoutTransform>
                                </TextBlock>
                            </Viewbox>
                        </Button>
                        <Button x:Name="InventoryTab" Click="Inventory_Click" Style="{StaticResource CatalogButton}" Background="Transparent" Padding="0" AutomationProperties.Name="база">
                            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="0,10">
                                <TextBlock Text="база" FontSize="18">
                                    <TextBlock.LayoutTransform>
                                        <RotateTransform Angle="-90"/>
                                    </TextBlock.LayoutTransform>
                                </TextBlock>
                            </Viewbox>
                        </Button>
                        <Button x:Name="TasksTab" Click="Tasks_Click" Style="{StaticResource CatalogButton}" Background="Transparent" Padding="0" AutomationProperties.Name="завдання">
                            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="0,10">
                                <TextBlock Text="завдання" FontSize="18">
                                    <TextBlock.LayoutTransform>
                                        <RotateTransform Angle="-90"/>
                                    </TextBlock.LayoutTransform>
                                </TextBlock>
                            </Viewbox>
                        </Button>
                        <Button x:Name="MessagesTab" Click="Messages_Click" Style="{StaticResource CatalogButton}" Background="Transparent" Padding="0" AutomationProperties.Name="повідомлення">
                            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="0,10">
                                <TextBlock Text="повідомлення" FontSize="18">
                                    <TextBlock.LayoutTransform>
                                        <RotateTransform Angle="-90"/>
                                    </TextBlock.LayoutTransform>
                                </TextBlock>
                            </Viewbox>
                        </Button>
                    </UniformGrid>
                </local:CatalogSurface>
            </Grid>
        </Viewbox>
    </Grid>
</Window>
