<?xml version='1.0' encoding='utf-8'?>
<Application xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:SportRentApp" x:Class="SportRentApp.App">
    <Application.Resources>
        <ResourceDictionary>
            <FontFamily x:Key="AppFont">pack://application:,,,/SportRentApp;component/Resources/Nunito/#Nunito</FontFamily>
            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
                <Setter Property="FontSize" Value="16"/>
            </Style>
            <Style TargetType="ToolTip">
                <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
